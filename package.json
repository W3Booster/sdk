{
  "name": "@w3booster/sdk",
  "version": "0.2.0",
  "description": "One SDK for realtime W3Booster match data in overlays and web apps.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "browser": "./src/index.js",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "bin": {
    "w3booster-settings": "./bin/sync-settings.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./selectors": {
      "types": "./src/selectors.d.ts",
      "import": "./src/selectors.js"
    },
    "./standard-game": {
      "types": "./src/standard-game.d.ts",
      "import": "./src/standard-game.js"
    },
    "./standard-game/objects": {
      "types": "./src/standard-game-objects.d.ts",
      "import": "./src/standard-game-objects.js"
    },
    "./assets": {
      "types": "./src/assets.d.ts",
      "import": "./src/assets.js"
    },
    "./settings": {
      "types": "./src/settings.d.ts",
      "import": "./src/settings.js"
    },
    "./app": {
      "types": "./src/app.d.ts",
      "import": "./src/app.js"
    },
    "./compositor": {
      "types": "./src/compositor.d.ts",
      "import": "./src/compositor.js"
    },
    "./testing": {
      "types": "./src/testing.d.ts",
      "import": "./src/testing.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "import": "./src/react.js"
    }
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "COMPATIBILITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:types": "tsc -p type-tests/tsconfig.json",
    "check": "npm test && npm run test:types && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "Chrome >= 92",
    "Edge >= 92",
    "Firefox >= 90",
    "Safari >= 15.4"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/W3Booster/sdk.git"
  },
  "homepage": "https://w3booster.com/developer/",
  "bugs": {
    "url": "https://github.com/W3Booster/sdk/issues"
  },
  "keywords": [
    "warcraft-iii",
    "overlay",
    "realtime",
    "websocket"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
